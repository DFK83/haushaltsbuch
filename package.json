{
  "name": "haushaltsbuch",
  "version": "1.0.10",
  "description": "Haushaltsbuch – lokale Einnahmen- und Ausgabenverwaltung",
  "author": "Daniel Kronawitter",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "de.kronawitter.haushaltsbuch",
    "productName": "Haushaltsbuch",
    "copyright": "© 2026 Daniel Kronawitter",
    "publish": [
      {
        "provider": "github",
        "owner": "DFK83",
        "repo": "haushaltsbuch"
      }
    ],
    "files": [
      "index.html",
      "app.js",
      "main.js",
      "preload.js",
      "icon.ico",
      "fonts/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "DFK83",
      "shortcutName": "Haushaltsbuch",
      "uninstallDisplayName": "Haushaltsbuch ${version}",
      "artifactName": "Haushaltsbuch-Setup-${version}-x64.${ext}"
    },
    "portable": {
      "artifactName": "Haushaltsbuch-Portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
